# MVGR-AI environment template. Copy to .env (never commit .env).

# --- Paths -----------------------------------------------------------------
MVGR_DATA_ROOT=datasets
MVGR_DERIVED_ROOT=data/derived
MVGR_MANIFEST_ROOT=data/manifests
MVGR_ARTIFACT_ROOT=experiments
MVGR_REPORT_ROOT=reports

# --- Neo4j (Person 2) ------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- Hugging Face (dataset audit only; never required by the online API) ---
HF_TOKEN=

# --- Backend ---------------------------------------------------------------
MVGR_API_HOST=127.0.0.1
MVGR_API_PORT=8000
MVGR_API_MAX_TEXT_CHARS=50000
MVGR_API_MODEL_BUNDLE=experiments/checkpoints/current

# --- Watermark verification ------------------------------------------------
# Watermark verification is opt-in and requires an explicit provider plus
# that provider's key/protocol. Absence of configuration means "unsupported",
# never "human authored".
MVGR_WATERMARK_PROVIDER=
MVGR_WATERMARK_KEY=
