{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvgr-ai.local/contracts/experiment_schema-1.0.0.json",
  "title": "MVGR-AI experiment record",
  "description": "Immutable metadata written when an experiment is registered, before any metric is produced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_schema_version",
    "experiment_id",
    "created_at",
    "config_id",
    "config",
    "dataset_version",
    "split_id",
    "graph_build_id",
    "graph_spec_version",
    "model_family",
    "seeds",
    "git_commit",
    "status"
  ],
  "properties": {
    "experiment_schema_version": { "const": "1.0.0" },
    "experiment_id": { "type": "string", "pattern": "^exp_[0-9a-f]{12,64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "config_id": { "type": "string", "pattern": "^cfg_[0-9a-f]{12,64}$" },
    "config": { "type": "object" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "split_id": { "type": "string", "pattern": "^split_[0-9a-f]{12,64}$" },
    "graph_build_id": { "type": "string", "minLength": 1 },
    "graph_spec_version": { "type": "string", "minLength": 1 },
    "model_family": { "type": "string", "minLength": 1 },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "git_commit": { "type": "string", "minLength": 1 },
    "status": { "enum": ["registered", "running", "completed", "failed", "invalidated"] },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
