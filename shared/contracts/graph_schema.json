{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvgr-ai.local/contracts/graph_schema-1.0.0.json",
  "title": "MVGR-AI graph export record",
  "description": "One line of a JSONL graph export. Deliberately contains no label, split, family, source, task, text_type or condition fields. Target metadata is joined only at evaluation time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "graph_view",
    "graph_spec_version",
    "graph_build_id",
    "config_id",
    "nodes",
    "edges",
    "empty"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "graph_view": {
      "enum": ["lexical", "syntactic"]
    },
    "graph_spec_version": {
      "const": "1.0.0"
    },
    "graph_build_id": {
      "type": "string",
      "pattern": "^gb_[0-9a-f]{12,64}$"
    },
    "config_id": {
      "type": "string",
      "pattern": "^cfg_[0-9a-f]{12,64}$"
    },
    "truncated": {
      "type": "boolean",
      "default": false
    },
    "empty": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 400000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "token", "node_type"],
      "properties": {
        "node_id": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "type": "string",
          "maxLength": 200
        },
        "node_type": {
          "enum": ["token", "punctuation", "sentence_id"]
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        },
        "pos": {
          "type": "string",
          "maxLength": 16
        },
        "is_stopword": {
          "type": "boolean"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "edge_type", "weight", "directed"],
      "properties": {
        "source": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "minimum": 0
        },
        "edge_type": {
          "enum": ["cooccurrence", "dependency"]
        },
        "dependency": {
          "type": "string",
          "maxLength": 32
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "directed": {
          "type": "boolean"
        },
        "sentence_index": {
          "type": "integer",
          "minimum": 0
        },
        "distance": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
